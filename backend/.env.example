# Copy to .env for local development. Never commit real values.
# These are already set as GitHub Actions secrets in CI/production — see CLAUDE.md.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose this to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000

# Comma-separated list of allowed frontend origins for CORS. Defaults to the
# local Vite dev server (http://localhost:5173) if unset.
FRONTEND_ORIGIN=

# URL of the frontend app, used as redirectTo in Supabase invite emails so the
# link goes to the React app rather than the backend API.
# Local dev: http://localhost:5173
# Production: the Vercel preview/production URL.
APP_FRONTEND_URL=http://localhost:5173

# Only needed to run `npm run bootstrap:admin` once against a fresh Supabase
# project — creates the first Platform Administrator so there's a user to
# log in with at all. See ticket 0093.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional, defaults to "Default Tenant".
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# ==============================================================================
# AI & AUTONOMOUS AGENT PROVIDER KEYS (M28, M29, M30)
# ==============================================================================
# Configure at least one provider key. The system automatically detects and uses
# the configured provider (or falls back to the built-in deterministic local engine).

# 1. OpenAI (Default: gpt-4o-mini, text-embedding-3-small)
OPENAI_API_KEY=
# Optional custom base URL (e.g. for OpenRouter, Ollama, vLLM, or LM Studio)
# OPENAI_BASE_URL=

# 2. Google Gemini (Default: gemini-1.5-flash, text-embedding-004)
# GEMINI_API_KEY=

# 3. Anthropic Claude (Default: claude-3-5-sonnet-20241022)
# ANTHROPIC_API_KEY=

# 4. Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Active system default provider: openai | gemini | anthropic | azure | local
# AI_DEFAULT_PROVIDER=openai
