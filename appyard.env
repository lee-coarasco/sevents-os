# AppYard kit settings. Copy to appyard.env at the repo root and commit it.
# Non-secret values only: tokens and webhook URLs belong in GitHub secrets.
# run.sh and notify.sh source this file if it exists; every value has a default.

# Per-session spend cap passed to `claude -p --max-budget-usd`.
AGENT_MAX_BUDGET_USD=10.00
# A session that ends normally at or above this cost, saying it stopped for budget,
# counts as "budget_near" and gets a fresh session. Keep it a little under the cap.
AGENT_NEAR_CAP_USD=9.0
# Extra sessions allowed in one run after a budget stop. Worst case per run is
# AGENT_MAX_BUDGET_USD x (AGENT_MAX_BUDGET_RETRIES + 1).
AGENT_MAX_BUDGET_RETRIES=2
# Daily limit across all sessions, in the same estimated dollars, checked against
# usage/ledger.tsv before every session. Empty = no daily limit. The AppYard
# dashboard can change it. Only people may edit this file: run.sh puts it back if
# a session changes it.
AGENT_DAILY_BUDGET_USD=100

# Working hours for scheduled runs (the hourly trigger still fires; run.sh skips
# a run that isn't due). "HH-HH" in the agent's time zone, e.g. 09-21, or 21-06
# across midnight; empty = all day. AGENT_EVERY_HOURS: every Nth hour from the
# window's start; empty or 1 = every hour. The AppYard dashboard changes these.
AGENT_ACTIVE_HOURS=
AGENT_EVERY_HOURS=

# After a session ends normally, start another in the same run (at most 3 per
# run, within the daily limit) while a ticket is ready and the session produced
# work. 0 = one session per run, except after a budget stop.
AGENT_CONTINUE_WHILE_WORK=1

# The tool permission gate that is actually enforced in headless mode. Keep in sync
# with what .claude/agents/*.md allow.
AGENT_ALLOWED_TOOLS="Edit,Bash(git *),Bash(npm *),Bash(pytest *),Bash(node *),Bash(python3 *),Bash(vercel *),WebFetch,WebSearch,mcp__supabase__*"

AGENT_MAIN_BRANCH=main
AGENT_TZ=Asia/Kolkata
# IANA timezone for the agent runner — sets TZ for run.sh and the daily log date.
# Set to your local timezone so log file dates match your clock, e.g. Asia/Kolkata.
AGENT_TZ=Asia/Kolkata

# --- Notification footer (appended to every Slack message) ---
# Label for a link to the newest GitHub Release (e.g. a mobile preview build). Empty = no link.
NOTIFY_RELEASE_LABEL=""
# File holding the latest preview URL, one line, written by the devops role. Empty = no link.
NOTIFY_PREVIEW_URL_FILE=""
NOTIFY_PREVIEW_LABEL="🌐 Latest web preview"
# Fixed links, "label|url" pairs separated by ";".
NOTIFY_LINKS=""
# This product in the AppYard dashboard, e.g. https://appyard.example.com/p/my-app.
# Failure alerts and ticket questions link to it. Empty = GitHub links only.
NOTIFY_DASHBOARD_URL="https://appyard-dashboard.vercel.app/p/sevents-os"
